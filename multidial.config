config globals 'globals'
	# Shipped dormant: no macvlan, mwan3, SQM or cake-autorate changes until
	# accounts are added and this is set to '1'.
	option enabled '0'
	option phy_ifname 'wan'
	# Set probe_url and track_ips before enabling. Use an HTTP 204 endpoint
	# and ICMP targets reachable from the uplinks. Example addresses below
	# are documentation placeholders.
	# option probe_url 'http://probe.example.test/check'
	# option track_ips '192.0.2.11 198.51.100.12'
	# option dns_servers '192.0.2.53'
	# option dns_rebind_domains 'internal.example.test'
	# option intranet_ranges '192.0.2.0/24'
	# option sticky_ranges '198.51.100.0/24'

#!/bin/sh /etc/rc.common
# procd service for the multi-dial management daemon (packaged install).
# The daemon itself honours globals.enabled: with '0' it stays dormant and only
# serves the LuCI page. It listens on 127.0.0.1 only; LuCI proxies to it.
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/python3 -m multidial
	procd_set_param env PYTHONPATH=/usr/lib/multidial \
		MULTIDIAL_HOST=127.0.0.1 MULTIDIAL_PORT=23334 PYTHONUNBUFFERED=1
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# re-reconcile when the operator edits the config in LuCI
	procd_add_reload_trigger "multidial"
}
